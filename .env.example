# Copiar para .env e ajustar. O .env nunca vai para o git.

# Ligação ao Postgres. Este valor corresponde ao docker-compose.yml.
DATABASE_URL=postgres://techgest:techgest_local@localhost:5433/techgest

# Porta do servidor Express em local. Em produção o Render define PORT.
PORT=3000

# Duração da sessão, em dias.
SESSAO_DIAS=7
